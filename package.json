{
  "author": "Clever Signal",
  "build": {
    "appId": "com.cleversignal.pricey",
    "copyright": "Copyright © 2026 Clever Signal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    },
    "productName": "Pricey",
    "win": {
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "zip"
        }
      ],
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.4.3",
    "papaparse": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "xlsx": "^0.18.5"
  },
  "description": "Universal product pricing, costing & profitability for makers, resellers and small manufacturers — by Clever Signal",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.5"
  },
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "name": "pricey",
  "private": true,
  "productName": "Pricey",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist:win": "npm run build && electron-builder --win --x64",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "version": "0.1.0"
}
